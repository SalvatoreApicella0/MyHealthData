  <string>MyHealthData usa il Bluetooth quando scegli di acquisire il peso dalla tua bilancia smart nelle vicinanze.</string>
  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array>
    <string>org.myhealthdata.ios.health-refresh</string>
